# =====================================================================
# FishingMails — Environment Configuration
# =====================================================================

# 1. OpenRouter LLM Gateway (Optional)
# Get a key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Optional free/fallback model: openrouter/free, meta-llama/llama-3.1-70b-instruct

# 2. Local Ollama Provider (Optional for 100% Offline / Confidential Payloads)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# 3. Neo4j Attack Graph (Optional: Defaults to in-memory fallback if unavailable)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin_password

# 4. Ingestion Daemons (Optional: For Live Corporate Mailboxes)
# Microsoft 365 Exchange Online
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# IMAP Polling
IMAP_HOST=mail.enterprise-corp.internal
IMAP_PORT=993
IMAP_USERNAME=security-ingest@enterprise-corp.internal
IMAP_PASSWORD=

# 5. SIEM Forwarding Destinations (Optional)
SPLUNK_HEC_URL=http://localhost:8088/services/collector
SPLUNK_HEC_TOKEN=
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=
