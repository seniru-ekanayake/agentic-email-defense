# =====================================================================
# FishingMails configuration. Copy to .env and fill in real values.
# Every variable below is read by the code; nothing else is needed.
# =====================================================================

# --- Environment ------------------------------------------------------
# production | staging | development | test   (default when unset: production)
FISHINGMAILS_ENV=production

# --- Secrets (required in production/staging, >= 32 chars, unique) -----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start in production if these are missing or placeholders.
FISHINGMAILS_AUTH_SECRET=
FISHINGMAILS_APPROVAL_HMAC_SECRET=

# --- Server -----------------------------------------------------------
FISHINGMAILS_DB_PATH=./data/fishingmails.db
FISHINGMAILS_CORS_ORIGINS=http://localhost:3000
FISHINGMAILS_MAX_EML_BYTES=26214400

# --- Threat intelligence (optional) ----------------------------------
# URLhaus requires an Auth-Key (https://auth.abuse.ch/). Without it, URLhaus is skipped.
URLHAUS_AUTH_KEY=
# Quad9 threat-blocking DNS needs no key.

# --- LLM planner (optional) -------------------------------------------
# Without a key, the deterministic rule planner is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Used instead of OpenRouter for payloads classified CONFIDENTIAL/RESTRICTED.
OLLAMA_BASE_URL=http://localhost:11434

# --- Response connectors (optional) -----------------------------------
# Each approved action is POSTed as JSON {"action", "parameters", "timestamp"} with
# "Authorization: Bearer <token>". Only an HTTP 2xx response counts as a confirmed action.
# See docs/CONNECTORS.md for the contract.
MAIL_GATEWAY_URL=
MAIL_GATEWAY_TOKEN=
IDP_API_URL=
IDP_API_TOKEN=
ACTIVE_DIRECTORY_URL=
ACTIVE_DIRECTORY_TOKEN=
IDP_PASSWORD_RESET_URL=
IDP_PASSWORD_RESET_TOKEN=
GATEWAY_BLOCK_URL=
GATEWAY_BLOCK_TOKEN=
FIREWALL_API_URL=
FIREWALL_API_TOKEN=
MAILBOX_SEARCH_URL=
MAILBOX_SEARCH_TOKEN=
SOC_TICKET_WEBHOOK_URL=
SOC_TICKET_WEBHOOK_TOKEN=

# --- Development only (rejected in production) ------------------------
# FISHINGMAILS_ALLOW_LOCAL_AUTH_FALLBACK=true
# DEFAULT_TENANT_ID=tenant-dev
